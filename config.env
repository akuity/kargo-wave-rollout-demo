# Demo settings. Any value can be overridden from the environment or from a git-ignored
# config.local.env next to this file, e.g.  make up INSTANCE=my-waves
: "${ORG:=demo}"                         # Akuity organization
: "${INSTANCE:=wave-rollout}"            # Argo CD and Kargo instance name (created and deleted by the demo)
: "${WEB_PROJECT:=web-service}"          # Kargo project for the Kubernetes service (teams/web-service)
: "${FN_PROJECT:=lambda-service}"        # Kargo project for the Lambda function (teams/lambda-service)
: "${CLUSTER:=waves}"                    # kind cluster, Kargo agent and Argo CD cluster name
: "${GIT_REPO:=https://github.com/akuity/kargo-wave-rollout-demo.git}"
: "${BASELINE:=blue}"                    # rollouts-demo tag every Stage starts on
: "${QA_GROUP:=qa-approvers}"            # SSO group that signs off releases (teams/*/kargo/roles)
: "${DEV_GROUP:=developers}"             # SSO group with read-only access
: "${ARGOCD_VERSION:=v3.5.5-ak.107}"
: "${KARGO_VERSION:=v1.12.4-ak.0}"
: "${KIND_NODE_IMAGE:=kindest/node:v1.37.0}"
: "${DOCKER_CONTEXT:=orbstack}"
# A GitHub token that can push to GIT_REPO (Kargo pushes the rendered branches).
# Either export GITHUB_TOKEN, or name a `pass` entry that holds it.
: "${PAT_PASS_ENTRY:=}"
