# Sidecar in front of rollouts-demo that applies the feature flags. The nginx image runs
# envsubst on this file at start, filling ${CHECKOUT_V2} and ${DARK_MODE} from the
# feature-flags ConfigMap; nginx's own $variables are left alone.

# CHECKOUT_V2=on sends ~30% of requests down the broken checkout path.
split_clients "$request_id" $checkout_v2_path {
    30%  broken;
    *    ok;
}
map "${CHECKOUT_V2}:$checkout_v2_path" $checkout_v2_fails {
    "on:broken"  1;
    default      0;
}

server {
    listen 8081;
    location / {
        add_header X-Feature-Checkout-V2 "${CHECKOUT_V2}" always;
        add_header X-Feature-Dark-Mode "${DARK_MODE}" always;
        if ($checkout_v2_fails) {
            return 500 "checkout_v2 failed\n";
        }
        proxy_pass http://127.0.0.1:8080;
    }
}
