# Feature flags for web-service: one per line, on or off. Change them with
# `make flag NAME=CHECKOUT_V2 VALUE=on`, which commits here. Kargo turns every commit
# into new Freight, so a flag change is promoted, verified and rolled back exactly like
# a new build, and always together with the image it shipped with.
#
#   CHECKOUT_V2  a new checkout path with a bug: when on, ~30% of requests fail with a 500
#   DARK_MODE    harmless; shows up only as a response header
CHECKOUT_V2=off
DARK_MODE=off
